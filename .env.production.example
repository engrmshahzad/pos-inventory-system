# ---- Production .env (copy to .env on the server and fill in) ----
APP_NAME="NexaPOS"
APP_ENV=production
APP_KEY=                       # php artisan key:generate --show
APP_DEBUG=false                # never true in production
APP_TIMEZONE=Asia/Karachi
APP_URL=https://pos.yourdomain.com

LOG_CHANNEL=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql            # mysql for MySQL 8; mariadb for MariaDB
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos
DB_USERNAME=pos_user           # a dedicated user, not root
DB_PASSWORD=change-me
DB_DUMP_PATH=/usr/bin/         # folder that contains mysqldump

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true     # HTTPS only
SESSION_SAME_SITE=lax

CACHE_STORE=database           # or redis
QUEUE_CONNECTION=database      # run a worker (Supervisor) — see docs/DEPLOYMENT.md
FILESYSTEM_DISK=local

MAIL_MAILER=smtp               # for password-reset emails
MAIL_HOST=smtp.yourprovider.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@yourdomain.com"
MAIL_FROM_NAME="${APP_NAME}"
